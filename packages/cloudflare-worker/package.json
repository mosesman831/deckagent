{
  "name": "@deckagent/cloudflare-worker",
  "version": "1.0.0",
  "description": "DeckAgent Cloudflare Worker: MCP Streamable HTTP endpoint, GitHub OAuth PKCE, WebSocket tunnel, and device registry",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "test": "tsx --test test/*.test.ts",
    "clean": "rm -rf dist .wrangler",
    "lint": "tsc"
  },
  "dependencies": {
    "@deckagent/mcp-server": "*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "0.17.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260704.1",
    "@types/node": "20.14.0",
    "react": "19.2.7",
    "tsx": "4.23.0",
    "typescript": "5.6.3",
    "wrangler": "4.106.0"
  }
}
